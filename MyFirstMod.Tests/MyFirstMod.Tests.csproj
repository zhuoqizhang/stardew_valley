<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Links the pure SettlementMath.cs/PriceModel.cs source files from the main mod project instead of a
    ProjectReference to MyFirstMod.csproj. MyFirstMod.csproj needs Harmony/SMAPI/StardewValley
    assemblies (via Pathoschild.Stardew.ModBuildConfig) to build - dependencies a plain unit-test
    project shouldn't need to resolve just to test pure logic. SettlementMath.cs/PriceModel.cs have
    zero such dependencies (see their own header comments), so linking just those files keeps this
    project buildable/testable without a game install.

    DateHelper.cs (and its ContractDueDateKind/ResolveDueDate) is deliberately NOT linked here: it
    needs StardewModdingAPI.Utilities.SDate, which would require hardcoded machine-specific
    <Reference> HintPaths to the game install and break the "any machine can build this" property
    above. Tried once (2026-09-11) and reverted at the user's request - ResolveDueDate's own logic is
    a two-line switch reviewable by eye, not worth that tradeoff.
  -->
  <ItemGroup>
    <Compile Include="..\SettlementMath.cs" Link="SettlementMath.cs" />
    <Compile Include="..\PriceModel.cs" Link="PriceModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="3.1.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
